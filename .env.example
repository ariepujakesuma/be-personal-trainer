# Database (TiDB Cloud / MySQL)
DATABASE_URL="mysql://user:password@host:4000/personal_trainer?sslaccept=strict"

# Auth
JWT_SECRET="ganti-dengan-string-acak-panjang"

# Frontend origin(s), comma separated
CORS_ORIGIN="http://localhost:3001"
APP_URL="http://localhost:3001"

# 9Router (instance ai-listen.creacon.id, API key khusus app ini)
NINEROUTER_BASE_URL="https://ai-listen.creacon.id"
NINEROUTER_API_KEY=""
AI_MODEL_VISION="pt-vision"
AI_MODEL_TEXT="pt-text"
# Set false kalau combo menolak response_format json_object
AI_JSON_MODE="true"
AI_TIMEOUT_MS="50000"

# Vercel Blob (foto makanan, private). Kosong = foto tidak disimpan, analisis tetap jalan
BLOB_READ_WRITE_TOKEN=""

# SMTP reminder email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AI Personal Trainer <no-reply@example.com>"

# Vercel Cron secret (Vercel mengirim header Authorization: Bearer $CRON_SECRET)
CRON_SECRET="ganti-dengan-string-acak"

PORT=3000
