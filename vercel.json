{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/api/v1/internal/cron/reminder", "schedule": "0 13 * * *" },
    { "path": "/api/v1/internal/cron/daily-summary", "schedule": "0 14 * * *" }
  ]
}
